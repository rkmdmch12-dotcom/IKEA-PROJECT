<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="IKEA_PROJECT.MainPage"
    FlowDirection="RightToLeft"
    BackgroundColor="#E8E8E8">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">

            <Label Text="IKEA NAVIGATOR"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="#00569D"
                   HorizontalOptions="Center"/>

            <Label Text="מערכת ניווט חכמה בתוך חנות איקאה"
                   FontSize="16"
                   TextColor="Black"
                   HorizontalOptions="Center"/>

            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 15"
                    Padding="18">

                <VerticalStackLayout Spacing="15">

                    <Label Text="נקודת מוצא"
                           FontAttributes="Bold"
                           FontSize="17"/>

                    <Picker x:Name="StartPicker"
                            Title="בחרי מאיפה את מתחילה"/>

                    <Label Text="נקודת יעד"
                           FontAttributes="Bold"
                           FontSize="17"/>

                    <Picker x:Name="TargetPicker"
                            Title="בחרי לאן את רוצה להגיע"/>

                </VerticalStackLayout>
            </Border>

            <Button Text="חשב מסלול"
                    BackgroundColor="#00569D"
                    TextColor="White"
                    CornerRadius="12"
                    Clicked="CalculateRoute_Clicked"/>

            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 15"
                    Padding="18">

                <VerticalStackLayout Spacing="12">

                    <Label Text="המסלול שלך"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#00569D"/>

                    <Label x:Name="RouteLabel"
                           Text="כאן יוצג המסלול"/>

                    <Label x:Name="LengthLabel"
                           Text="מרחק: -"/>

                    <Label x:Name="TimeLabel"
                           Text="זמן הליכה: -"/>

                    <Label x:Name="StatusLabel"
                           Text=""
                           TextColor="Green"/>

                </VerticalStackLayout
                                     <!-- אזור הציור הגרפי של המסלול -->
                <GraphicsView x:Name="mapGraphicsView"
              HeightRequest="200"
              WidthRequest="300"
              BackgroundColor="#F0F0F0"
              HorizontalOptions="Center" /> >
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
